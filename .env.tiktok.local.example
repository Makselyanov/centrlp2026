# CentrLP TikTok service. Copy secrets only to /etc/centrlp/tiktok.env on the
# production host with mode 0600. Never commit a populated copy.

TIKTOK_ENVIRONMENT=sandbox
TIKTOK_APP_ID=7666838773159905301

# Sandbox and production credentials are intentionally separate. Populate only
# the pair selected by TIKTOK_ENVIRONMENT; the service refuses to start when
# credentials for the inactive environment are also present.
TIKTOK_SANDBOX_CLIENT_KEY=
TIKTOK_SANDBOX_CLIENT_SECRET=
TIKTOK_PRODUCTION_CLIENT_KEY=
TIKTOK_PRODUCTION_CLIENT_SECRET=

TIKTOK_PUBLIC_ORIGIN=https://centrlp.ru
TIKTOK_REDIRECT_URI=https://centrlp.ru/tiktok/callback
TIKTOK_EXPECTED_USERNAME=centrlp

# Add after the first verified @centrlp authorization to pin both username and
# TikTok open_id. Leave blank only for that controlled first authorization.
TIKTOK_EXPECTED_OPEN_ID=

# Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Keep the key outside git and back it up separately from the encrypted store.
TIKTOK_SESSION_MASTER_KEY=
TIKTOK_SESSION_STORE_PATH=/var/lib/centrlp-tiktok/sessions.enc.json
TIKTOK_SESSION_MAX_AGE_DAYS=365
TIKTOK_CONSENT_AUDIT_PATH=/var/lib/centrlp-tiktok/consent-audit.enc.json
TIKTOK_CONSENT_AUDIT_RETENTION_DAYS=365
TIKTOK_PORT=3023

# Fail-closed legal/compliance gate. Keep 0 until the separate Russian
# cross-border personal-data review and required notification are confirmed.
TIKTOK_CROSS_BORDER_APPROVED=0
