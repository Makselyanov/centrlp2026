# Copy this file to .env.seo.local and fill in the real values.
# Do not commit .env.seo.local.

YANDEX_WEBMASTER_CLIENT_ID=
YANDEX_WEBMASTER_TOKEN=
YANDEX_WEBMASTER_HOST_URL=https://centrlp.ru/
YANDEX_WEBMASTER_USER_ID=
YANDEX_WEBMASTER_HOST_ID=
YANDEX_WEBMASTER_TOKEN_EXPIRES_AT=2026-09-26

# Яндекс Метрика: отдельный read-only OAuth-токен владельца счётчика CentrLP.
# Скрипт проверяет домен счётчика и не примет доступ от другого проекта.
YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_COUNTER_ID=50135101

# Google Search Console (used by scripts/gsc-report.mjs)
# Onboarding: G:/mvp/centrlp/plans/seo-onboarding-oauth-gsc.md
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_SITE_URL=sc-domain:centrlp.ru
