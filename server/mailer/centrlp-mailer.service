[Unit]
Description=CentrLP lead mailer — Express+nodemailer on 127.0.0.1:3021
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/centrlp/server/mailer
EnvironmentFile=/var/www/centrlp/.env.mailer.local
ExecStart=/usr/bin/node /var/www/centrlp/server/mailer/index.mjs
Restart=always
RestartSec=5
StandardOutput=append:/var/log/centrlp-mailer.log
StandardError=append:/var/log/centrlp-mailer.log
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/centrlp/server/mailer/logs /var/log
PrivateTmp=true

[Install]
WantedBy=multi-user.target
